// ============================================================
// StockSense — Prisma Schema
// Owner: Teammate 2 (Backend & Data Lead)
//
// Auth boundary:
//   The User model here is a MINIMAL database record only.
//   Teammate 3 owns all authentication, JWT, RBAC, password
//   hashing, and session management. Do NOT add auth fields
//   (passwordHash, tokens, etc.) to this model without
//   coordinating with Teammate 3.
//
// Stock Ledger invariant:
//   StockLedger is append-only at the SERVICE layer.
//   The application must NEVER issue UPDATE or DELETE
//   against stock_ledger rows. Corrections are handled
//   by writing new reversal entries.
//
// Operation lifecycle (enforced in service layer):
//   DRAFT -> CONFIRMED  (writes StockLedger entries atomically)
//   DRAFT -> CANCELLED  (no ledger entries written)
//   CONFIRMED -> (cannot be cancelled directly; requires a
//                 reversal operation that writes compensating
//                 ledger entries)
//
// Internal transfer ledger rule (enforced in service layer):
//   An INTERNAL_TRANSFER confirmation must write TWO entries:
//     1. quantity = -(N) at sourceLocationId
//     2. quantity = +(N) at destinationLocationId
//   Both rows share the same operationId.
//
// Stock-on-hand query pattern:
//   SELECT SUM(quantity) FROM stock_ledger
//   WHERE product_id = $1 AND location_id = $2
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum UserRole {
  ADMIN
  WAREHOUSE_MANAGER
  OPERATOR
}

enum LocationType {
  INTERNAL  // Physical shelf/bin/zone inside a warehouse
  INPUT     // Receiving dock / incoming staging buffer
  OUTPUT    // Dispatch dock / outbound staging buffer
  SUPPLIER  // Virtual: represents an external supplier source
  CUSTOMER  // Virtual: represents an external customer destination
  SCRAP     // Virtual: destination for damaged/scrapped goods
}

enum OperationType {
  RECEIPT           // Incoming stock from supplier -> internal location
  DELIVERY          // Outgoing stock from internal location -> customer
  INTERNAL_TRANSFER // Stock movement between two internal locations
  ADJUSTMENT        // Inventory count correction (positive or negative delta)
}

enum OperationStatus {
  DRAFT      // Being built; no ledger entries written yet
  CONFIRMED  // Locked; ledger entries written atomically on confirmation
  CANCELLED  // Voided before confirmation; no ledger entries written
}

// ─────────────────────────────────────────────
// USER
// Minimal database record. Auth is owned by Teammate 3.
// createdById on operations and ledger entries is nullable
// so the system functions before auth is integrated.
// ─────────────────────────────────────────────

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  passwordHash String
  role      UserRole @default(OPERATOR)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  operations    StockOperation[]
  ledgerEntries StockLedger[]

  @@map("users")
}

// ─────────────────────────────────────────────
// WAREHOUSE
// ─────────────────────────────────────────────

model Warehouse {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  locations Location[]

  @@map("warehouses")
}

// ─────────────────────────────────────────────
// LOCATION
// warehouseId is nullable to allow virtual locations
// (SUPPLIER, CUSTOMER, SCRAP) that do not belong to
// a physical warehouse.
// ─────────────────────────────────────────────

model Location {
  id          String       @id @default(uuid())
  code        String
  name        String
  type        LocationType @default(INTERNAL)
  warehouseId String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  warehouse Warehouse? @relation(fields: [warehouseId], references: [id])

  sourceOperations      StockOperation[] @relation("SourceLocation")
  destinationOperations StockOperation[] @relation("DestinationLocation")
  ledgerEntries         StockLedger[]

  @@unique([warehouseId, code])
  @@index([type])
  @@map("locations")
}

// ─────────────────────────────────────────────
// PRODUCT
// No currentStock field. Stock on hand is always
// derived by SUM(quantity) on stock_ledger.
// reorderLevel uses Decimal for fractional unit support.
// ─────────────────────────────────────────────

model Product {
  id            String   @id @default(uuid())
  sku           String   @unique
  barcode       String?  @unique
  name          String
  description   String?
  category      String?
  unitOfMeasure String   @default("units")
  costPrice     Decimal  @default(0) @db.Decimal(12, 4)
  reorderLevel  Decimal  @default(0) @db.Decimal(12, 4)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  lines         StockOperationLine[]
  ledgerEntries StockLedger[]

  @@index([sku])
  @@index([barcode])
  @@index([category])
  @@map("products")
}

// ─────────────────────────────────────────────
// STOCK OPERATION
// Header record for any inventory operation.
// sourceLocationId / destinationLocationId semantics:
//   RECEIPT           -> source = SUPPLIER location, dest = INPUT/INTERNAL
//   DELIVERY          -> source = INTERNAL location,  dest = CUSTOMER location
//   INTERNAL_TRANSFER -> source = INTERNAL location,  dest = INTERNAL location
//   ADJUSTMENT        -> source/dest depend on delta direction (service layer)
// Ledger entries are written ONLY when status -> CONFIRMED.
// ─────────────────────────────────────────────

model StockOperation {
  id                    String          @id @default(uuid())
  reference             String          @unique
  operationType         OperationType
  status                OperationStatus @default(DRAFT)
  sourceLocationId      String?
  destinationLocationId String?
  createdById           String?
  notes                 String?
  scheduledDate         DateTime?
  confirmedAt           DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  sourceLocation      Location? @relation("SourceLocation",      fields: [sourceLocationId],      references: [id])
  destinationLocation Location? @relation("DestinationLocation", fields: [destinationLocationId], references: [id])
  createdBy           User?     @relation(fields: [createdById], references: [id])

  lines         StockOperationLine[]
  ledgerEntries StockLedger[]

  @@index([operationType])
  @@index([status])
  @@index([createdAt])
  @@map("stock_operations")
}

// ─────────────────────────────────────────────
// STOCK OPERATION LINE
// Individual product quantities within an operation.
// quantity here is always POSITIVE — it represents
// the requested/declared amount. Sign is applied by
// the ledger service at confirmation time based on
// operationType and direction.
// ─────────────────────────────────────────────

model StockOperationLine {
  id          String  @id @default(uuid())
  operationId String
  productId   String
  quantity    Decimal @db.Decimal(12, 4)
  unitCost    Decimal @default(0) @db.Decimal(12, 4)

  operation StockOperation @relation(fields: [operationId], references: [id], onDelete: Cascade)
  product   Product        @relation(fields: [productId], references: [id])

  @@index([operationId])
  @@index([productId])
  @@map("stock_operation_lines")
}

// ─────────────────────────────────────────────
// STOCK LEDGER  ← Single Source of Truth
//
// Append-only. Rows must NEVER be updated or deleted
// after creation. All stock corrections are handled
// by inserting new compensating entries.
//
// Signed quantity convention:
//   positive (+) = stock arriving at locationId
//   negative (-) = stock leaving locationId
//
// Stock on hand for a product at a location:
//   SELECT SUM(quantity) FROM stock_ledger
//   WHERE product_id = $1 AND location_id = $2
//
// Internal transfer creates TWO rows per product line:
//   Row 1: quantity = -(N), locationId = sourceLocationId
//   Row 2: quantity = +(N), locationId = destinationLocationId
// Both rows reference the same operationId.
// ─────────────────────────────────────────────

model StockLedger {
  id          String   @id @default(uuid())
  operationId String
  productId   String
  locationId  String

  // Signed: positive = incoming to location, negative = outgoing from location
  quantity    Decimal  @db.Decimal(12, 4)

  unitCost    Decimal  @default(0) @db.Decimal(12, 4)

  // Denormalized for fast display without join
  reference   String?

  createdById String?
  createdAt   DateTime @default(now())

  operation StockOperation @relation(fields: [operationId], references: [id])
  product   Product        @relation(fields: [productId], references: [id])
  location  Location       @relation(fields: [locationId], references: [id])
  createdBy User?          @relation(fields: [createdById], references: [id])

  // Critical: stock-on-hand SUM query (product + location)
  @@index([productId, locationId])
  // Product movement history ordered by time
  @@index([productId, createdAt])
  // Fetch all ledger entries for one operation
  @@index([operationId])

  @@map("stock_ledger")
}
